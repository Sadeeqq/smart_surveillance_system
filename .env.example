SSS_TRACKER_CONFIG=bytetrack.yaml
SSS_TRACKING_TRAIL_LENGTH=30
SSS_STORAGE_DIR=data
SSS_EVENT_COOLDOWN_SECONDS=5
SSS_TELEGRAM_ENABLED=false
SSS_TELEGRAM_BOT_TOKEN=
SSS_TELEGRAM_CHAT_ID=
